# Copy to .env next to docker-compose.yml and fill in.
POSTGRES_PASSWORD=change-me
JWT_SIGNING_KEY=generate-a-random-64-char-string
ADMIN_PASSWORD=choose-a-strong-one
PUBLIC_API_URL=http://localhost:8080
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:8081
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Firebase phone login (project buildmate24x7). Web app config from Firebase console > Project settings > Your apps >
# Web app. Public identifiers, not secrets — but the website must be REBUILT after changing them.
FIREBASE_PROJECT_ID=buildmate24x7
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# API's own SMS OTP (fallback, not used by the website/app when Firebase is set). "Log" never sends an SMS.
SMS_PROVIDER=Log
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
DEMO_DATA=false
